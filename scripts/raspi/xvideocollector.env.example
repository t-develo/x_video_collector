# X Video Collector — スタンドアロン運用の設定
#
# install.sh がこのファイルを雛形として /etc/xvideocollector/xvideocollector.env を生成する。
# 既にファイルが存在する場合は上書きしない（設定は再インストールで失われない）。
#
# 変更後は反映のためサービスを再起動する:
#   sudo systemctl restart xvideocollector

# ── 待ち受け ───────────────────────────────────────────────
# LAN 内の他端末からアクセスするため 0.0.0.0 で待ち受ける。
# 認証を掛けていないため、ufw 等で LAN サブネットに限定すること。
ASPNETCORE_URLS=http://0.0.0.0:8080
DOTNET_ENVIRONMENT=Production

# ── 一時ファイル ───────────────────────────────────────────
# Raspberry Pi OS の /tmp は tmpfs (RAM) の場合があり、
# 数百 MB の動画をダウンロードすると OOM で kill される。必ず実ディスクを指す。
TMPDIR=/var/lib/xvideocollector/tmp

# ── 認証 ───────────────────────────────────────────────────
# LAN 内のみで運用するため認証なし。
# リバースプロキシで X-MS-CLIENT-PRINCIPAL を付与する構成にする場合は false にする。
SKIP_AUTH=true

# ── 実装の選択（Azure ではなくローカルを使う） ─────────────
Storage__Provider=Local
Queue__Provider=InProcess

# ── データベース (SQLite) ──────────────────────────────────
ConnectionStrings__SqlDb=Data Source=/var/lib/xvideocollector/xvideocollector.db

# ── メディア保存先 ─────────────────────────────────────────
# 外付け SSD/USB を使う場合はマウントポイント配下に変更する
# 例: LocalStorage__RootPath=/mnt/videos/xvideocollector
LocalStorage__RootPath=/var/lib/xvideocollector/media
# 署名付きメディア URL の鍵。install.sh が openssl rand で自動生成する。
LocalStorage__SigningKey=__XVC_SIGNING_KEY__
# 空き容量がこれを下回るとダウンロードを中止し /api/health が Unhealthy になる (MB)
LocalStorage__MinimumFreeDiskMB=1024

BlobStorage__VideoContainerName=videos
BlobStorage__ThumbnailContainerName=thumbnails

# ── ダウンロードワーカー ───────────────────────────────────
# DB を走査して未処理の動画を拾い直す間隔 (秒)
DownloadWorker__SweepIntervalSeconds=300
# Downloading / Processing のまま滞留した動画を中断扱いにするまでの時間 (分)
DownloadWorker__StaleAfterMinutes=30

# ── yt-dlp / ffmpeg ────────────────────────────────────────
YtDlp__ExecutablePath=/usr/local/bin/yt-dlp
YtDlp__FfmpegPath=/usr/bin/ffmpeg
YtDlp__FfprobePath=/usr/bin/ffprobe
# Raspberry Pi は非力なため Azure の 300 秒から延長している
YtDlp__TimeoutSeconds=900
YtDlp__MaxFileSizeMB=500
# X は多くの動画で認証を要求する。Netscape 形式の cookies ファイルを置いたら
# 次行のコメントを外す（未設定なら yt-dlp に --cookies を渡さない）。
#YtDlp__CookiesPath=/etc/xvideocollector/cookies.txt

# ── バックアップ ───────────────────────────────────────────
# 保持する世代数
XVC_BACKUP_RETENTION=14

# ── ログ ───────────────────────────────────────────────────
# 詳細ログが必要な場合は Debug に変更する
Logging__LogLevel__Default=Information
