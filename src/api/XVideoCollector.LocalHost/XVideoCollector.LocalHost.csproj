<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>XVideoCollector.LocalHost</RootNamespace>
    <!-- 発行物にフロントエンドを含めるため wwwroot をプロジェクト外から生成する -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XVideoCollector.Application\XVideoCollector.Application.csproj" />
    <ProjectReference Include="..\XVideoCollector.Infrastructure\XVideoCollector.Infrastructure.csproj" />
  </ItemGroup>

  <!-- フロントエンド SPA を wwwroot として同梱する（staticwebapp.config.json は SWA 専用のため除外） -->
  <ItemGroup>
    <Content Include="..\..\frontend\**\*"
             Exclude="..\..\frontend\staticwebapp.config.json"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>XVideoCollector.LocalHost.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
