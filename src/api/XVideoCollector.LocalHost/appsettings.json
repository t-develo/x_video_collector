{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Storage": {
    "Provider": "Local"
  },
  "Queue": {
    "Provider": "InProcess"
  },
  "LocalStorage": {
    "MediaPathBase": "/api/media",
    "MinimumFreeDiskMB": 1024
  },
  "DownloadWorker": {
    "SweepIntervalSeconds": 300,
    "StaleAfterMinutes": 30
  },
  "AllowedHosts": "*"
}
